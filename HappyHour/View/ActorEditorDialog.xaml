        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Clear" Margin="0,0,5,5" Padding="2" Command="{Binding CmdClearActors}"/>
            <Button Content="Close" Margin="0,0,5,5" Padding="2" IsCancel="True" Click="Close"/>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Orientation="Horizontal"
                           HorizontalAlignment="Center" Margin="5">
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ActorInitials}">
                        <ItemsControl.ItemsPanel>
                            <!-- specify the panel that is the container for your items -->
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"  HorizontalAlignment="Left" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <!-- specify the template used to render each item -->
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton
                                    Margin="5,0,0,5"
                                    Content="{Binding Initial}"
                                    IsChecked="{Binding IsChecked}">
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <ListBox Margin="5,0,0,5" Grid.Row="1"
                    SelectionMode="Extended" x:Name="_actorListbox"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemsPanel="{StaticResource ImagePanelTemplate}"
                    ItemsSource="{Binding Actors}"
                    SelectedItem="{Binding SelectedActor}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding CmdDoubleClick}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <i:Interaction.Behaviors>
                        <bh:ListboxBehavior />
                    </i:Interaction.Behaviors>
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Template" Value="{StaticResource _controlTpl}"/>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Merge Actors"
                                      Command="{Binding CmdMergeActors}"
                                      CommandParameter="{Binding RelativeSource={RelativeSource
                                AncestorType={x:Type ContextMenu}}, Path=PlacementTarget.SelectedItems}"/>
                            <MenuItem Header="Remove"
                                      Command="{Binding CmdRemoveActor}"
                                      CommandParameter="{Binding RelativeSource={RelativeSource
                                AncestorType={x:Type ContextMenu}}, Path=PlacementTarget.SelectedItem}"/>

                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>
            <DockPanel Grid.Column="1" Width="200">
                <DockPanel DockPanel.Dock="Top">
                    <ListBox  Height="150" Margin="5,10,5,0"
                              ItemsSource="{Binding ActorNames}"
                              SelectedItem="{Binding SelectedActorName}">
                        <ListBox.InputBindings>
                            <KeyBinding Command="{Binding CmdDeleteNameOfActor}" Key="Delete"/>
                        </ListBox.InputBindings>
                        <i:Interaction.Behaviors>
                            <bh:ListboxBehavior/>
                        </i:Interaction.Behaviors>
                    </ListBox>
                </DockPanel>
                <DockPanel>
                    <ctrls:DelayedBindingTextBox DelayTime="500" DockPanel.Dock="Top" Margin="5,5,5,0"
                             Text="{Binding SearchText}"/>
                    <ListBox ItemsSource="{Binding SearchNames}" Margin="5"
                             SelectedItem="{Binding SelectedSearchName}">
<!--
                        <ListBox.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding CmdActorNameDoubleClick}"/>
                        </ListBox.InputBindings>
-->
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction
                                    Command="{Binding CmdSearchNameDoubleClick }"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <i:Interaction.Behaviors>
                            <bh:ListboxBehavior/>
                        </i:Interaction.Behaviors>
                    </ListBox>
                </DockPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
