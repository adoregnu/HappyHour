<Window x:Class="HappyHour.View.TranslatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:HappyHour.View"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="TranslatorDialog" Height="400" Width="600" WindowStartupLocation="CenterScreen">
    <Window.Resources>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <ComboBox Grid.Row="0" Grid.Column="0" Margin="2,2,1,2"
                  ItemsSource="{Binding LangsLeft}" SelectedItem="{Binding SelectedLeftLang}"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="1,2,2,2"
                  ItemsSource="{Binding LangsRight}" SelectedItem="{Binding SelectedRightLang}"/>
        <ae:TextEditor Grid.Row="1" Grid.Column="0" Margin="2,0,1,2"
            Document="{Binding LeftDocument, UpdateSourceTrigger=PropertyChanged}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
        </ae:TextEditor>
        <ae:TextEditor Grid.Row="1" Grid.Column="1" Margin="2,0,1,2"
            Document="{Binding RightDocument, UpdateSourceTrigger=PropertyChanged}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
        </ae:TextEditor>
        <StackPanel Grid.Row="2" Grid.Column="2"  Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Update" Margin="2" Command="{Binding CmdUpdate}"/>
        </StackPanel>
    </Grid>
</Window>
