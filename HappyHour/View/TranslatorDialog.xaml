<Window x:Class="HappyHour.View.TranslatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:HappyHour.View"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="TranslatorDialog" Height="400" Width="600" WindowStartupLocation="CenterScreen">
    <Window.Resources>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ComboBox Margin="2" Grid.Column="0"
                  ItemsSource="{Binding Translators}" SelectedItem="{Binding SelectedTranslator}"/>
            <ComboBox Margin="0,2,2,2" Grid.Column="1"
                  ItemsSource="{Binding LangsLeft}" SelectedItem="{Binding SelectedLeftLang}"/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="2">
             <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Row="0" Grid.Column="0" Margin="2"
                      ItemsSource="{Binding LangsRight}" SelectedItem="{Binding SelectedRightLang}"/>
            <Button Grid.Row="0" Grid.Column="1" Margin="0,2,2,2" Content="Translate"
                Command="{Binding CmdTranslate}"/>
        </Grid>
        <ae:TextEditor Grid.Row="1" Grid.Column="0" Margin="2,0,2,2"
            BorderBrush="Gray" BorderThickness="1"
            Document="{Binding LeftDocument, UpdateSourceTrigger=PropertyChanged}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">
        </ae:TextEditor>
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ae:TextEditor Margin="2,0,2,2" Grid.Row="0"
                BorderBrush="Gray" BorderThickness="1"
                Document="{Binding RightDocument, UpdateSourceTrigger=PropertyChanged}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
            </ae:TextEditor>
            <Grid Grid.Row="1" Visibility="{Binding IsChatVisible}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBox Margin="2,0,2,2" Grid.Column="0" Text="{Binding ChatText, UpdateSourceTrigger=PropertyChanged}" >
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding CmdChat}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Content="Chat" Margin="0,0,2,2"  Grid.Column="1"
                        Command="{Binding CmdChat}"/>
            </Grid>
        </Grid>
        <Button Grid.Row="2" Grid.Column="0" Content="Update Source" Margin="2,0,2,2" Width="100"
                Command="{Binding CmdUpdateSource}"/>
        <Button Grid.Row="2" Grid.Column="2" Content="Update Target" Margin="2,0,2,2"
                Command="{Binding CmdUpdateTarget}" Width="100"/>
    </Grid>
</Window>
