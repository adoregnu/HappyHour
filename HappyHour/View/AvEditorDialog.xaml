<Window x:Class="HappyHour.View.AvEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:control="clr-namespace:HappyHour.View.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        Height="500" Width="800" SizeToContent="Height">
    <Window.Resources>
        <DataTemplate x:Key="ActorMiniTemplate">
            <StackPanel Orientation="Horizontal">
                <control:AsyncImage HorizontalAlignment="Center" Width="64" ImageBlob="{Binding Thumb}"/>
                <TextBlock Text="{Binding .}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="TextboxStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Row="0" Grid.ColumnSpan="4" Text="{Binding Movie.VideoUrl}" Style="{StaticResource TextboxStyle}"/>
        <ListBox Grid.Row="1" Grid.ColumnSpan="4" ItemsSource="{Binding Movie.Title}" Height="50"/>
        <Grid Grid.Row="2" Grid.ColumnSpan="4" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Released : " Grid.Column="0"
                       TextAlignment="Right"/>
            <TextBox Grid.Column="1" Style="{StaticResource TextboxStyle}"
                       Text="{Binding Movie.DateReleased, StringFormat='{}{0:yyyy-MM-dd}'}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Leaked PID : " Margin="5,0,0,0" VerticalAlignment="Center"/>
                <TextBox Width="130" Text="{Binding Movie.AltPID}" Style="{StaticResource TextboxStyle}"/>
            </StackPanel>
            <CheckBox Grid.Column="3" Margin="5,0,5,0" IsChecked="{Binding Movie.Censored}" VerticalAlignment="Center">
                <TextBlock Text="Sensored" />
            </CheckBox>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition />
                <RowDefinition Height="Auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Label/Maker" DockPanel.Dock="Left" TextAlignment="Center" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Movie.Lable.Name}"/>
            <Button Grid.Row="2" Content="Set" Width="30" Command="{Binding CmdSetLabel}"/>
            <ListBox Grid.Row="3" ItemsSource="{Binding ComboBoxStyle}" SelectedItem="{Binding SelectedLabel}" />
        </Grid>
        <Grid Grid.Row="3" Grid.Column="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock Text="Series : " DockPanel.Dock="Left"
                          Width="60" TextAlignment="Right" />
                <TextBox Text="{Binding Series, Mode=OneWay}"
                         Style="{StaticResource TextboxStyle}"/>
            </DockPanel>
            <DockPanel Grid.Column="1">
                <Button DockPanel.Dock="Right" Content="Set" Margin="2,0,2,0"
                        Width="30" Command="{Binding CmdSetSeries}"/>
                <ComboBox ItemsSource="{Binding AllSeries}" Margin="5,0,5,0"
                          SelectedItem="{Binding SelectedSeries}"
                          IsEditable="True" IsTextSearchEnabled="True"
                          Style="{StaticResource ComboBoxStyle}"/>
            </DockPanel>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,2,0">
                <TextBlock Text="Genres : " DockPanel.Dock="Left"
                          Width="60" TextAlignment="Right" />
                <ListBox MinHeight="50" MaxHeight="100" ItemsSource="{Binding Genres}"
                         SelectedItem="{Binding SelectedAvGenre}"
                         Style="{StaticResource ListBoxStyle}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding CmdRemoveGenre}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ListBox>
            </DockPanel>
             <ListBox Grid.Column="2" MaxHeight="100" ItemsSource="{Binding AllGenres}"
                      SelectedItem="{Binding SelectedGenre}"
                      Style="{StaticResource ListBoxStyle}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction Command="{Binding CmdAddGenre}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="3" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" VerticalAlignment="Top">
                <TextBlock Text="Actors : " DockPanel.Dock="Left"
                          Width="60" TextAlignment="Right" />
                <ListBox MinHeight="60" MaxHeight="300" ItemsSource="{Binding Actors}"
                         Style="{StaticResource ListBoxStyle}"
                         SelectedItem="{Binding SelectedAvActor}"
                         ItemTemplate="{StaticResource ActorMiniTemplate}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding CmdRemoveActor}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="2,0,0,0">
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock DockPanel.Dock="Left" Text="Search: "/>
                    <TextBox Margin="0,0,0,2"
                         Style="{StaticResource TextboxStyle}"
                         Text="{Binding SearchActorName, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <ListBox MaxHeight="300" ItemsSource="{Binding AllActors}"
                     ItemTemplate="{StaticResource ActorMiniTemplate}"
                     SelectedItem="{Binding SelectedActor}"
                     Style="{StaticResource ListBoxStyle}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseDoubleClick">
                            <i:InvokeCommandAction Command="{Binding CmdAddActor}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ListBox>
            </DockPanel>
        </Grid>

        <TextBox Grid.Row="4" Grid.ColumnSpan="4" Height="60" Text="{Binding Av.Plot}" />
        <StackPanel Grid.Row="5" Grid.ColumnSpan="4" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Save" Margin="0,0,5,5"
                    Command="{Binding CmdSave}" Click="Close"/>
            <Button Content="Cancel" Margin="0,0,5,5" Click="Close"/>
        </StackPanel>
    </Grid>
</Window>
