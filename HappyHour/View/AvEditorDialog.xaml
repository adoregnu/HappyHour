<Window x:Class="HappyHour.View.AvEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:control="clr-namespace:HappyHour.View.Controls"
        xmlns:vm="clr-namespace:HappyHour.ViewModel"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        Height="600" Width="1024" SizeToContent="Height">
    <Window.Resources>
        <DataTemplate x:Key="ActorMiniTemplate">
            <Grid>
                <control:AsyncImage HorizontalAlignment="Center" VerticalAlignment="Top"
                                    ImageBlob="{Binding Thumb}" Width="64" />
                <StackPanel VerticalAlignment="Bottom" Background="Black" Opacity="0.6">
                    <TextBlock Text="{Binding .}" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style x:Key="TextboxStyle" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ListBoxStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox Grid.Row="0" Grid.ColumnSpan="5" Text="{Binding Movie.VideoUrl}"
                 Margin="5,5,5,0" Style="{StaticResource TextboxStyle}"/>
        <ListBox Grid.Row="1" Grid.ColumnSpan="5" ItemsSource="{Binding Movie.Title}" Height="40"
                 Margin="5,5,5,0"/>
        <Grid Grid.Row="2" Grid.ColumnSpan="5" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Released : " TextAlignment="Right"/>
            <TextBox Grid.Column="1" Style="{StaticResource TextboxStyle}"
                       Text="{Binding Movie.DateReleased, StringFormat='{}{0:yyyy-MM-dd}'}"/>
            <TextBlock Grid.Column="2" Text="Added : " TextAlignment="Right"/>
            <TextBox Grid.Column="3" Style="{StaticResource TextboxStyle}"
                       Text="{Binding Movie.DateAdded, StringFormat='{}{0:yyyy-MM-dd}'}"/>

            <StackPanel Grid.Column="4" Orientation="Horizontal">
                <TextBlock Text="Alt PID : " Margin="5,0,0,0" VerticalAlignment="Center"/>
                <TextBox Width="130" Text="{Binding Movie.AltPID}" Style="{StaticResource TextboxStyle}"/>
            </StackPanel>
            <CheckBox Grid.Column="5" Margin="5,0,5,0" IsChecked="{Binding Movie.Censored}">
                <TextBlock Text="Sensored" />
            </CheckBox>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Maker" TextAlignment="Center" />

            <ListBox Grid.Row="1" Margin="5,0,0,5" ItemsSource="{Binding Movie.Maker}" x:Name="_movieMakers">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding CmdRemove}"
                            CommandParameter="{Binding ElementName=_movieMakers,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>
            <ListBox Grid.Row="2" Margin="5,0,0,0" ItemsSource="{Binding AllMakers}" x:Name="_allMakers">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding CmdAdd}"
                            CommandParameter="{Binding ElementName=_allMakers,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>

        </Grid>
        <Grid Grid.Row="3" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Label" TextAlignment="Center" />
            <ListBox Grid.Row="1" Margin="5,0,0,5" ItemsSource="{Binding Movie.Label}" x:Name="_movieLabel">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding CmdRemove}"
                            CommandParameter="{Binding ElementName=_movieLabel,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>
            <ListBox Grid.Row="2" Margin="5,0,0,0" ItemsSource="{Binding AllLabels}" x:Name="_allLabels">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding CmdAdd}"
                            CommandParameter="{Binding ElementName=_allLabels,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="8*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Series" TextAlignment="Center"/>
            <ListBox Grid.Row="1" Margin="5,0,0,5" ItemsSource="{Binding Series}" x:Name="_movieSeries">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding CmdRemove}"
                            CommandParameter="{Binding ElementName=_movieSeries,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>
            <ListBox Grid.Row="2" Margin="5,0,0,0" ItemsSource="{Binding AllSeries}" x:Name="_allSeries">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding CmdAdd}"
                            CommandParameter="{Binding ElementName=_allSeries,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>

            </ListBox>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Genres" TextAlignment="Center" />
            <ListBox Grid.Row="1" Margin="5,0,0,5" ItemsSource="{Binding Genres}" x:Name="_movieGenre">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding CmdRemove}"
                            CommandParameter="{Binding ElementName=_movieGenre,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>
            <ListBox Grid.Row="2" Margin="5,0,0,0" ItemsSource="{Binding AllGenres}" x:Name="_allGenres"
                      SelectedItem="{Binding SelectedGenre}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding CmdAdd}"
                            CommandParameter="{Binding ElementName=_allGenres,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>
        </Grid>
        <Grid Grid.Row="3" Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="7*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Actors" TextAlignment="Center" />
            <ListBox Grid.Row="1" Margin="5,0,5,5" ItemsSource="{Binding Actors}" x:Name="_actors"
                     ItemTemplate="{StaticResource ActorMiniTemplate}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding CmdRemove}"
                            CommandParameter="{Binding ElementName=_actors,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>
            <TextBox Grid.Row="2" Margin="5,0,5,5" Text="{Binding SearchText}"/>
            <ListBox Grid.Row="3" Margin="5,0,5,0" ItemsSource="{Binding AllActors}" x:Name="_allActors"
                 ItemTemplate="{StaticResource ActorMiniTemplate}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDoubleClick">
                        <i:InvokeCommandAction
                            Command="{Binding CmdAddActor}"
                            CommandParameter="{Binding ElementName=_allActors,Path=SelectedItem}"/>
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ListBox>
        </Grid>

        <TextBox Grid.Row="4" Grid.ColumnSpan="5" Height="60" Margin="5,5,5,0"
                 Text="{Binding Movie.Plot}" />
        <StackPanel Grid.Row="5" Grid.ColumnSpan="5" Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="Save" Margin="0,5,5,5" Command="{Binding CmdSave}" Click="Close"/>
            <Button Content="Cancel" Margin="0,5,5,5" Click="Close"/>
        </StackPanel>
    </Grid>
</Window>
